---
/**
 * A line set large in the essay. Pull quotes normally repeat a sentence from
 * the text, so they are hidden from screen readers by default; pass
 * `repeat={false}` when the quote is the only place the words appear.
 *
 *   <PullQuote>A model that refuses a question can still finish a story.</PullQuote>
 */
interface Props {
  repeat?: boolean;
}
const { repeat = true } = Astro.props;
---

<aside class="pull-quote" aria-hidden={repeat ? 'true' : undefined}>
  <p><slot /></p>
</aside>

<style>
  .pull-quote {
    margin-block: 2.25em !important;
    padding-block: 1.1em 0.25em;
    border-top: 2px solid var(--accent);
  }
  .pull-quote p {
    font-family: var(--font-quote);
    font-size: clamp(1.3rem, 1.15rem + 0.6vw, 1.6rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: balance;
  }
  /* On wide screens the quote breaks out into the right margin. */
  @media (min-width: 80rem) {
    .pull-quote {
      margin-right: calc(-1 * (var(--side) + var(--col-gap)));
    }
    .pull-quote p {
      max-width: 30ch;
    }
  }
</style>
