---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <>
      <nav class="toc-desktop" aria-labelledby="toc-title">
        <p class="kicker" id="toc-title">
          Contents
        </p>
        <ol>
          {items.map((h) => (
            <li class:list={[`d${h.depth}`]}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
      <details class="toc-mobile">
        <summary class="kicker">Contents</summary>
        <nav aria-label="Contents">
          <ol>
            {items.map((h) => (
              <li class:list={[`d${h.depth}`]}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    </>
  )
}

<style>
  ol {
    list-style: none;
    padding: 0;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  li {
    padding-block: 0.3rem;
  }
  li.d3 {
    padding-left: 0.85rem;
    font-size: 0.8125rem;
  }
  a {
    text-decoration: none;
    color: var(--ink-2);
  }
  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .toc-desktop {
    display: none;
  }
  .toc-desktop .kicker {
    margin-bottom: 0.6rem;
  }
  .toc-desktop ol {
    border-left: 1px solid var(--rule);
    padding-left: 0.85rem;
  }
  .toc-mobile {
    max-width: var(--measure);
    margin-bottom: 2rem;
    border-block: 1px solid var(--rule);
  }
  .toc-mobile summary {
    padding-block: 0.8rem;
    cursor: pointer;
    list-style-position: inside;
  }
  .toc-mobile summary::marker {
    color: var(--accent);
  }
  .toc-mobile nav {
    padding-bottom: 0.9rem;
  }
  @media (min-width: 80rem) {
    .toc-desktop {
      display: block;
      position: sticky;
      top: 6rem;
      max-height: calc(100dvh - 8rem);
      overflow-y: auto;
    }
    .toc-mobile {
      display: none;
    }
  }
</style>
