---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../lib/schema';
interface Props {
  kicker?: string;
  title: string;
  lede?: string;
  crumbs?: Crumb[];
}
const { kicker, title, lede, crumbs } = Astro.props;
---

<header class="page-head wrap">
  {crumbs && <Breadcrumbs crumbs={crumbs} />}
  {kicker && <p class="kicker reveal" style="--i:0">{kicker}</p>}
  <h1 class="reveal" style="--i:1">{title}</h1>
  {lede && <p class="lede reveal" style="--i:2">{lede}</p>}
  <slot />
</header>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(2rem, 5vw, 3rem);
  }
  .page-head > :global(nav) {
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  h1 {
    margin-top: 0.85rem;
    font-size: clamp(1.75rem, 1.3rem + 1.9vw, 2.6rem);
    letter-spacing: -0.045em;
    line-height: 1.08;
    max-width: 24ch;
  }
  .lede {
    margin-top: 1.25rem;
    max-width: 58ch;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.55;
    color: var(--ink-2);
  }
</style>
